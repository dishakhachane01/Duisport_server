    <style>
        body {
            background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='794' height='1123'%3E%3Ctext x='397' y='561' font-size='60' font-family='DejaVu Sans,Arial,sans-serif' font-weight='bold' fill='%23CC0000' fill-opacity='0.15' text-anchor='middle' dominant-baseline='middle' transform='rotate(-45 397 561)'%3ENOT APPROVED PO%3C/text%3E%3C/svg%3E");
            background-repeat: repeat;
            background-size: 794px 1123px;
              background-attachment: fixed;
            -webkit-print-color-adjust: exact;
        }
    </style>
