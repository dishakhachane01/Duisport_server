<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchase_order_custom">
        <t t-call="web.basic_layout">
            <meta charset="utf-8"/>
            <style>
                    @page {
        size: A4;
        margin: 2mm;
        -webkit-print-color-adjust: exact;  <!-- ADD THIS -->
        print-color-adjust: exact;           <!-- ADD THIS -->
    }
    body {
        font-size: 16px;
        font-family: "DejaVu Sans", "Noto Sans", Arial, sans-serif;
        -webkit-print-color-adjust: exact;   <!-- ADD THIS -->
    }
                .cell {
                    border: 0.6px solid #777;
                    padding: 6px;
                    vertical-align: top;
                    font-size: 16px;
                }

                .item-cell {
                    border-left: 0.6px solid #777;
                    border-right: 0.6px solid #777;
                    border-top: 0;
                    border-bottom: 0;
                    padding: 6px;
                }


                .center {
                    text-align: center;
                }

                table {
                    page-break-inside: auto;
                }

                tr {
                    page-break-after: auto;
                }

                .no-break {
                    page-break-inside: avoid;
                }

                th {
                    font-weight: normal;
                }

            </style>

            <t t-foreach="docs" t-as="o">

                <div style="position: relative; width:100%;">
                  <style>
        <t t-if="o.state == 'purchase'">
            body {
                background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='300' height='300'%3E%3Ctext x='50%25' y='50%25' font-size='32' font-family='DejaVu Sans,Arial,sans-serif' font-weight='bold' fill='%2300AA00' fill-opacity='0.13' text-anchor='middle' dominant-baseline='middle' transform='rotate(-45 150 150)'%3EAPPROVED PO%3C/text%3E%3C/svg%3E");
                background-repeat: repeat;
                background-size: 794px 1123px;
            }
        </t>
        <t t-if="o.state != 'purchase'">
            body {
                background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='300' height='300'%3E%3Ctext x='50%25' y='50%25' font-size='26' font-family='DejaVu Sans,Arial,sans-serif' font-weight='bold' fill='%23CC0000' fill-opacity='0.13' text-anchor='middle' dominant-baseline='middle' transform='rotate(-45 150 150)'%3ENOT APPROVED PO%3C/text%3E%3C/svg%3E");
                background-repeat: repeat;
                background-size: 794px 1123px;
            }
        </t>
    </style>


<!-- <t t-if="o.state == 'purchase'">
    <style>
        body {
            background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='794' height='1123'%3E%3Ctext x='397' y='561' font-size='60' font-family='DejaVu Sans,Arial,sans-serif' font-weight='bold' fill='%2300AA00' fill-opacity='0.15' text-anchor='middle' dominant-baseline='middle' transform='rotate(-45 397 561)'%3EAPPROVED PO%3C/text%3E%3C/svg%3E");
