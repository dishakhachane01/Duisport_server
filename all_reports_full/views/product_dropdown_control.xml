<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================= -->
    <!-- SALES ORDER -->
    <!-- ============================= -->
    <record id="sale_order_product_dropdown_fix" model="ir.ui.view">
        <field name="name">sale.order.product.dropdown.fix</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">

            <!-- Disable create in order line product -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>

        </field>
    </record>


    <!-- ============================= -->
    <!-- PURCHASE ORDER -->
    <!-- ============================= -->
    <record id="purchase_order_product_dropdown_fix" model="ir.ui.view">
        <field name="name">purchase.order.product.dropdown.fix</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">

            <!-- Disable create in purchase order line -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>

        </field>
    </record>


    <!-- ============================= -->
    <!-- INVENTORY -->
    <!-- ============================= -->
    <record id="stock_picking_product_dropdown_fix" model="ir.ui.view">
        <field name="name">stock.picking.product.dropdown.fix</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">

            <!-- Disable create in stock move lines -->
            <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>

        </field>
    </record>

</odoo>