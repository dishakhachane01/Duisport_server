<!-- Submit for Approval button: visible to salesperson, only after sending email -->
<record id="view_order_form_submit_button" model="ir.ui.view">
    <field name="name">sale.order.form.submit.approval</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

        <!-- Step 1: Declare approval_state as invisible field in header -->
        <xpath expr="//header/field[@name='locked']" position="after">
            <field name="approval_state" invisible="1"/>
        </xpath>

        <!-- Step 2: Add the Submit button after the Send by Email (primary) button -->
        <xpath expr="//header/button[@name='action_quotation_send'][@id='send_by_email_primary']" position="after">
            <button name="action_submit_for_approval"
                    string="Submit for Approval"
                    type="object"
                    groups="sales_team.group_sale_salesman"
                    class="oe_highlight"
                    invisible="state != 'sent' or approval_state == 'submitted'"/>
        </xpath>

    </field>
</record>

<!-- Replace Confirm button: only visible to Accounts team, only when submitted -->
<record id="sale_order_form_header_replace_confirm" model="ir.ui.view">
    <field name="name">sale.order.form.header.replace.confirm</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//header/button[@name='action_confirm']" position="replace">
            <button name="action_confirm"
                    string="Confirm"
                    type="object"
                    groups="account.group_account_user"
                    class="oe_highlight"
                   />
        </xpath>
    </field>
</record>

<!-- Add approval_state to the statusbar -->
<record id="view_order_form_approval_statusbar" model="ir.ui.view">
    <field name="name">sale.order.form.approval.statusbar</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='state']" position="replace">
            <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale"/>
            <field name="approval_state" widget="statusbar" statusbar_visible="draft,sent,submitted"/>
        </xpath>
    </field>
</record>



<!-- Hide Send by Email, Preview, Cancel, Create Revision from Accounts team when submitted -->
<record id="view_order_form_accounts_button_visibility" model="ir.ui.view">
    <field name="name">sale.order.form.accounts.button.visibility</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

        <!-- Hide Send by Email (primary - draft state) -->
        <xpath expr="//header/button[@id='send_by_email_primary']" position="attributes">
    <attribute name="invisible">approval_state in ('submitted', 'approved')</attribute>
</xpath>

<xpath expr="//header/button[@id='send_by_email']" position="attributes">
    <attribute name="invisible">approval_state in ('submitted', 'approved')</attribute>
</xpath>

<xpath expr="//header/button[@name='action_preview_sale_order']" position="attributes">
    <attribute name="invisible">approval_state in ('submitted', 'approved')</attribute>
</xpath>

<xpath expr="//header/button[@name='action_cancel']" position="attributes">
    <attribute name="invisible">approval_state in ('submitted', 'approved')</attribute>
</xpath>

        <!-- Hide Create Revision (from sale_management if installed, safe to include here) -->
        <xpath expr="//header/button[@name='action_create_revision']" position="attributes">
            <attribute name="invisible">approval_state == 'submitted'</attribute>
        </xpath>


<xpath expr="//field[@name='state']" position="attributes">
    <attribute name="invisible">approval_state in ('submitted', 'approved')</attribute>
</xpath>
        
    </field>
</record>



</odoo>
