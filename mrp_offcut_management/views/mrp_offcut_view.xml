<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="view_mrp_offcut_tree" model="ir.ui.view">
        <field name="name">mrp.offcut.tree</field>
        <field name="model">mrp.offcut</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="production_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_mrp_offcut_form" model="ir.ui.view">
        <field name="name">mrp.offcut.form</field>
        <field name="model">mrp.offcut</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="production_id"/>
                        <field name="store_location_id"/>
                        <field name="state" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Offcut Lines">
                            <field name="offcut_line_ids">
                                   <tree editable="bottom">
        
                                        <!-- ADD THIS LINE -->
                                        <field name="available_product_ids" invisible="1"/>

                                        <field name="product_id"/>
                                        <field name="planned_length"/>
                                        <field name="actual_length"/>
                                        <field name="offcut_length" readonly="1"/>
                                        <field name="quantity"/>
                                        <field name="total_offcut" readonly="1"/>
                                    </tree>
                            </field>
                        </page>
                    </notebook>

                   <footer>
                        <button name="action_submit"
                                type="object"
                                string="Submit to Store"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_approve"
                                type="object"
                                string="Approve"
                                class="btn-success"
                                invisible="state != 'submitted'"/>
                    </footer>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_mrp_offcut" model="ir.actions.act_window">
        <field name="name">Offcut Entries</field>
        <field name="res_model">mrp.offcut</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>