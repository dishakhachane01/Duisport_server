
<odoo>
    <record id="view_mrp_production_form_offcut" model="ir.ui.view">
        <field name="name">mrp.production.form.offcut</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Offcuts">
                    <field name="offcut_ids">
                        <tree editable="bottom">
                                
                                <field name="available_product_ids" invisible="1"/>

                                <field name="product_id"/>
                                <field name="planned_length"/>
                                <field name="actual_length"/>
                                <field name="offcut_length" readonly="1"/>
                                <field name="quantity"/>
                                <field name="total_offcut" readonly="1"/>
                                <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
