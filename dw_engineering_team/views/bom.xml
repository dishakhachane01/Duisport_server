<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_packing_cost_sheet_form" model="ir.ui.view">
        <field name="name">packing.cost.sheet.form</field>
        <field name="model">packing.cost.sheet</field>
        <field name="arch" type="xml">
            <form string="Packing Cost Sheet">
            <field name="is_locked" invisible="1"/>
                <sheet>
                    <!-- <div class="alert alert-warning" role="alert" invisible="state != 'revision'">
    <strong>QC Remarks: </strong>
    <field name="qc_remark" readonly="1" nolabel="1"/>
</div> -->
                    <header>
                     <button name="action_recalculate_dimensions" 
                                string="Recalculate Dimensions" 
                                type="object" 
                                class="btn-primary"
                                  invisible="is_locked"
                                 groups="dw_engineering_product.group_engineering_person"/>

                    <button name="action_lock_bom"
                        string="🔒 Lock BOM"
                        type="object"
                        class="btn-warning"
                        invisible="is_locked"
                        confirm="Lock this BOM? No further revisions will be possible."
                        groups="dw_engineering_product.group_engineering_person"
                    />

                    <button name="action_unlock_bom"
                        string="🔓 Unlock BOM"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_locked"
                        confirm="Unlock this BOM to allow new revisions?"
                        groups="dw_engineering_product.group_engineering_person"
                    />

                    <button name="action_create_revision"
                        string="Create Revision"
                        type="object"
                        invisible="is_locked"
                        groups="dw_engineering_product.group_engineering_person"
                    />
                       

                        <!-- <button name="action_create_revision"
                                string="Create Revision"
                                type="object"
                                groups="dw_engineering_product.group_engineering_team"
                                class="oe_highlight"
                               /> -->

                        <button name="action_view_revisions"
                                string="View All Revisions"
                                type="object"
                                class="btn-secondary"
/>
                    </header>
<!-- 
                    <div class="oe_title">
                        <h1>
                            <field name="sequence_no" readonly="1"/>
                            <span invisible="revision_no == 0"> / Rev-</span>
                            <field name="revision_no" readonly="1" class="oe_inline" invisible="revision_no == 0"/>
                        </h1>
                    </div> -->
                    <div class="oe_title">
                        <h1>
                            <field name="display_sequence" string="Sequence Number" readonly="1"/>
                        </h1>
                    </div>
                        <div class="alert alert-warning mb-0" role="alert"
             invisible="not is_locked">
            <strong>🔒 This BOM is locked.</strong> No fields can be edited.
        </div>


                    <!-- HEADER -->
                    <group col="4" readonly="is_locked">
                        <!-- <field name="ref"/> -->
                        <field name="reference_bom_id"/>
                        <field name="part_name"/>
                        <field name="part_weight"/>
                        <field name="moq"/>
                        <field name="empty_box_weight"/>
                        <field name="parent_id" invisible="1"/>
                        <field name="bom_type"/>
                    </group>
                    
                    <separator string="Dimension"/>

                    <table class="o_list_view table table-bordered" style="width:650px;" readonly="is_locked">
                        <thead>
                            <tr>
                                <th>Sizes</th>
                                <th>Length</th>
                                <th>Width</th>
                                <th>Height</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr invisible="bom_type in ('pinewood_pallet','pinewood_plywood')">
                                <td invisible="bom_type in ('pinewood_pallet','pinewood_plywood')"><strong>Box/Pallet ID</strong></td>
                                <td><field name="box_id_l" nolabel="1" readonly="is_locked"  invisible="bom_type in ('pinewood_pallet','pinewood_plywood')"/></td>
                                <td><field name="box_id_w" nolabel="1" readonly="is_locked"  invisible="bom_type in ('pinewood_pallet','pinewood_plywood')"/></td>
                                <td><field name="box_id_h" nolabel="1" readonly="is_locked"  invisible="bom_type in ('pinewood_pallet','pinewood_plywood')"/></td>
                            </tr>
                            <tr>
                                <td><strong>Box/Pallet OD</strong></td>
                                <td><field name="box_od_l" readonly="is_locked" nolabel="1"/></td>
                                <td><field name="box_od_w" readonly="is_locked" nolabel="1"/></td>
                                <td><field name="box_od_h" readonly="is_locked" nolabel="1"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <notebook>
                        <!-- COST DETAILS -->
                         
                        <!-- 🔵 NORMAL BOM PAGE -->
                        <page string="Material Details"
                            invisible="bom_type == 'ch_box'">

                            <field name="line_ids" readonly="is_locked">
                                <tree editable="bottom">
                                    <field name="section"/>
                                    <field name="description"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="thickness"/>
                                    <field name="qty"/>
                                    <field name="sqft" readonly="1"/>
                                    <field name="material_id"/>
                                    <field name="rm_rate" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                    <field name="amount" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                </tree>
                            </field>

                        </page>


                        <!-- 🟢 CH BOX PAGE -->
                        <page string="CH Box Details"
                            invisible="bom_type != 'ch_box'">

                            <field name="line_ids" readonly="is_locked">
                                <tree editable="bottom">
                                    <field name="sr_no"/>
                                    <field name="box_type"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="no_of_ply"/>
                                    <field name="board_gsm"/>
                                    <field name="deckle"/>
                                    <field name="cl"/>
                                    <field name="weight_kg"/>
                                    <field name="sqm"/>
                                </tree>
                            </field>

                        </page>
                        <!-- <page string="Cost Details">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sheet_id" invisible="1"/>
                                    <field name="section" invisible="sheet_id.bom_type == 'ch_box'"/>
                                    <field name="description"  invisible="sheet_id.bom_type == 'ch_box'" domain="[('section', '=', section)]"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="thickness"  invisible="sheet_id.bom_type == 'ch_box'"/>
