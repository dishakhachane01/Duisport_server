                                    <field name="sqft" readonly="1"/>
                                    <field name="material_id"  invisible="sheet_id.bom_type == 'ch_box'"/>
                                    <field name="rm_rate" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                    <field name="amount" readonly="1" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                    <field name="sr_no" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="box_type" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="height" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="no_of_ply" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="board_gsm" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="deckle" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="cl" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="weight_kg" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="sqm" invisible="sheet_id.bom_type != 'ch_box'"/>
                                    <field name="box_rate" invisible="sheet_id.bom_type != 'ch_box'"/>
                                </tree>
                            </field>
                        </page> -->

                        <!-- SUMMARY -->
                        <page string="Summary">
                            <group col="10">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_sqft" readonly="1"/>
                                <field name="total_cft" readonly="1"/>
                                <field name="material_total" readonly="1" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                <field name="mfg_percent" widget="percentage" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                <field name="mfg_amount" readonly="1" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                <field name="overhead_percent" widget="percentage" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                <field name="overhead_amount" readonly="1" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                <field name="profit_percent" widget="percentage" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                <field name="profit_amount" readonly="1" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                <field name="packing_charges" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                <field name="freight" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                  <field name="discount_percent" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                                <field name="discount_amount" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>

                                <field name="grand_total" readonly="1"
                                       class="oe_highlight" groups="dw_engineering_product.group_engineering_team,dw_crm.group_crm_sales_team,dw_crm.group_crm_admin"/>
                            </group>
                        </page>

                        <!-- REVISIONS TAB -->
                        <page string="Revisions" groups="dw_engineering_product.group_engineering_team">
                            <field name="child_ids" readonly="1">
                                <tree>
                                    <field name="sequence_no"/>
                                    <field name="revision_no"/>
                                    <field name="ref"/>   
                                    <field name="part_name"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="QC Revision History"
                            invisible="not revision_history_ids">
                            <field name="revision_history_ids" readonly="1">
                                <tree decoration-danger="status == 'pending'"
                                    decoration-success="status == 'resolved'"
                                    create="false" delete="false" editable="false">
                                    <field name="date"/>
                                    <field name="requested_by"/>
                                    <field name="revision_no" string="Rev No"/>
                                    <field name="remark"/>
                                    <field name ="attachment"/>
                                    <field name="status" widget="badge"
                                        decoration-danger="status == 'pending'"
                                        decoration-success="status == 'resolved'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_packing_cost_sheet_tree" model="ir.ui.view">
        <field name="name">packing.cost.sheet.tree</field>
        <field name="model">packing.cost.sheet</field>
        <field name="arch" type="xml">
            <tree string="Packing Cost Sheet">
                <!-- <field name="sequence_no"/>-->
                
                <field name="display_sequence"/>
                 <!-- <field name="highest_revision" string="Revision No"/> -->
                <field name="ref"/>
                <field name="part_name"/>
                <field name="part_weight"/>
                <field name="moq"/>
                <field name="empty_box_weight"/>
                        <field name="bom_type"/>

                <!-- <field name="parent_id" invisible="1"/> -->
            </tree>
        </field>
    </record>

    <record id="view_packing_cost_revision_wizard_form" model="ir.ui.view">
        <field name="name">packing.cost.revision.wizard.form</field>
        <field name="model">packing.cost.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Revision">
                <sheet>
                    <group>
                        <field name="sheet_id" readonly="1"/>
                        <field name="remark" placeholder="Describe what needs to be corrected…"/>
                        <field name="attachment"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_revision"
                            string="Send Back to Engineering"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_packing_cost_revision_wizard" model="ir.actions.act_window">
    <field name="name">Request Revision</field>
    <field name="res_model">packing.cost.revision.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>



