<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Form View -->
        <record id="view_packing_cost_form" model="ir.ui.view">
            <field name="name">pallet.cost.sheet.form</field>
            <field name="model">pallet.cost.sheet</field>
            <field name="arch" type="xml">
                <form string="Packing Cost Calculator">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="part_name"/>
                            </h1>
                        </div>
                        
                        <!-- Part Name Section -->
                            <group string="Size Details">
                                    <table class="o_list_view table table-sm table-bordered" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th>Sizes</th>
                                                <th>Length</th>
                                                <th>Width</th>
                                                <th>Height</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><strong>Box ID</strong></td>
                                                <td><field name="box_id_l" nolabel="1"/></td>
                                                <td><field name="box_id_w" nolabel="1"/></td>
                                                <td><field name="box_id_h" nolabel="1"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Box OD</strong></td>
                                                <td><field name="box_od_l" nolabel="1"/></td>
                                                <td><field name="box_od_w" nolabel="1"/></td>
                                                <td><field name="box_od_h" nolabel="1"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                            </group>



                            <group>
                                <field name="part_weight"/>
                                <field name="moq"/>
                                <field name="empty_pallet_weight"/>
                              
                        </group>
                        

                        <notebook>
                        <page string="Cost Details">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="section"/>
                                    <field name="description"/>

                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="sq_inch" readonly="1"/>
                                    <field name="sq_ft" readonly="1"/>

                                    <!-- <field name="calculation_type"/>
                                    <field name="rate"/>
                                    <field name="cost" readonly="1"/> -->
                                </tree>
                            </field>
                             <!-- ================= TOTALS ================= -->
                            <group col="4" class="oe_subtotal_footer oe_right">

                                <field name="total_sq_inch" readonly="1"/>
                                <field name="wastage_percent"/>
                                <field name="total_sq_inch_with_wastage" readonly="1"/>
                                <field name="cft" readonly="1"/>

                                <field name="total_cost" readonly="1"
                                    widget="monetary"
                                    options="{'currency_field': 'company_currency_id'}"/>
                            </group>

                        
                        </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    
  

        <record id="sequence_packing_cost" model="ir.sequence">
            <field name="name">Packing Cost Sequence</field>
            <field name="code">pallet.cost.sheet</field>
            <field name="prefix">PC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    <record id="action_heavy_pallets_bags" model="ir.actions.act_window">
        <field name="name">Bill of material</field>
        <field name="res_model">pallet.cost.sheet</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_heavy_pallet_bags"
              name="Bill of material"
              parent="menu_engineering_root"
              action="action_heavy_pallets_bags"/>


</odoo>
