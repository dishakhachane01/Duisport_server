<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_engineering_team_tree" model="ir.ui.view">
        <field name="name">engineering.team.tree</field>
        <field name="model">engineering.team</field>
        <field name="arch" type="xml">
            <tree string="Engineering Analysis">
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="engineer_id" string="Salesperson"/>
                <field name="state"/>
                <field name="date_done"/>
            </tree>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_engineering_team_form" model="ir.ui.view">
        <field name="name">engineering.team.form</field>
        <field name="model">engineering.team</field>
        <field name="arch" type="xml">

            <form string="Engineering Analysis">

                <!-- REQUIRED FOR PRODUCT DOMAIN -->
                <field name="company_id" invisible="1"/>

                <header>
                      
                    <button name="action_analysis_done"
                            type="object"
                            string="Analysis Done"
                            class="btn-primary"
                            groups="dw_engineering_product.group_engineering_team"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="lead_id"/>
                        <field name="partner_id" readonly="1"/>
                        <!-- <field name="engineer_id"/> -->
                         <field name="design_document" filename="design_document_filename"/>
                        <field name="date_done" readonly="1"/>
                    </group>

                    <notebook>

                        <!-- ENGINEERING DETAILS -->
                        <page string="Engineering Details">
                            <group>
                                <field name="design_ref" filename="design_ref_filename"/>
                                <field name="estimation_time"/>
                                <field name="engineering_notes"/>
                            </group>
                        </page>

                        <!-- PRODUCTS -->
                        <page string="Products">
                            <field name="product_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="cost_price"/>
                                    <field name="product_weight"/>
                                    <!-- <field name="cost_price_m"
                                           groups="dw_engineering_product.group_management_team"/> -->
                                    <field name="total_price" readonly="1"/>
                                    <button name="action_create_packing_cost_sheet"
        type="object"
        string="Create Cost Sheet"
        class="btn-primary"/>
                                </tree>
                            </field>
                        </page>

                        <page string="CRM Responses">
                            <field name="engineering_response_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="lead_id"/>
                                    <field name="note"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="lead_id" readonly="1"/>
                                        <field name="date" readonly="1"/>
                                        <field name="user_id" readonly="1"/>
                                        <field name="note"/>
                                        <field name="attachment" filename="attachment_filename"/>
                                    </group>
                                </form>
                            </field>
                        </page>


                    </notebook>
                </sheet>
                
                <!-- ================= CHATTER ================= -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>



        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_engineering_team" model="ir.actions.act_window">
        <field name="name">Engineering Analysis</field>
        <field name="res_model">engineering.team</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================= MENUS ================= -->
    <menuitem id="menu_engineering_root"  name="Engineering" groups="dw_engineering_product.group_engineering_team,dw_engineering_team.group_packing_quality_team" sequence="8"/>
    <menuitem id="menu_engineering_analysis"
              name="Analysis"
              parent="menu_engineering_root"
              action="action_engineering_team"
              groups="dw_engineering_product.group_engineering_team"/>

</odoo>
