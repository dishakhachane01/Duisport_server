<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_cost_breakup_form" model="ir.ui.view">
        <field name="name">cost.breakup.form</field>
        <field name="model">cost.breakup</field>
        <field name="arch" type="xml">
            <form string="Cost Break Up">
                <sheet>

                    <!-- HEADER -->
                    <group col="4">
                        <field name="name"/>
                        <field name="case_type"/>
                        <field name="product_weight"/>
                        <field name="box_type"/>
                    </group>

                    <notebook>

                        <page string="Dimensions">

                            <!-- HEADER ROW -->
                            <div class="o_row" style="border-bottom:1px solid #dfe3e8; padding-bottom:5px; margin-bottom:5px;">
                                <div class="o_col o_form_label" style="width:120px;">Sizes</div>
                                <div class="o_col o_form_label">L</div>
                                <div class="o_col o_form_label">W</div>
                                <div class="o_col o_form_label">H</div>
                                <div class="o_col o_form_label">T</div>
                            </div>

                            <!-- INCH ROW -->
                            <div class="o_row"  style="border-bottom:1px solid #dfe3e8; padding-bottom:5px; margin-bottom:5px;">
                                <div class="o_col o_form_label">Inch</div>
                                <div class="o_col"><field name="size_l" nolabel="1"/></div>
                                <div class="o_col"><field name="size_w" nolabel="1"/></div>
                                <div class="o_col"><field name="size_h" nolabel="1"/></div>
                                <div class="o_col"><field name="thickness" nolabel="1"/></div>
                            </div>

                            <!-- OD ROW -->
                            <div class="o_row"  style="border-bottom:1px solid #dfe3e8; padding-bottom:5px; margin-bottom:5px;">
                                <div class="o_col o_form_label">OD</div>
                                <div class="o_col"><field name="size_l_od" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_w_od" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_h_od" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_t_od" nolabel="1" readonly="1"/></div>
                                
                            </div>

                            <!-- MM ROW -->
                            <div class="o_row"  style="border-bottom:1px solid #dfe3e8; padding-bottom:5px; margin-bottom:5px;">
                                <div class="o_col o_form_label">MM</div>
                                <div class="o_col"><field name="size_l_mm" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_w_mm" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_h_mm" nolabel="1" readonly="1"/></div>
                                <div class="o_col"><field name="size_t_mm" nolabel="1" readonly="1"/></div>
                                
                            </div>

                        </page>
                       
                        <page string="Cost Details">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="section"/>
                                    <field name="description"/>
                                    <field name="length"/>
                                    
                                    <field name="width"/>
                                    
                                    <field name="height"/>
                                    <!-- <field name="thickness"/> -->
                                    <field name="qty"/>
                                    <field name="sq_inch" readonly="1"/>
                                </tree>
                                <!-- <field name="total_sq_inch" readonly="1"/> -->
                            </field>
                            <group class="oe_subtotal_footer oe_right">

                                <field name="total_sq_inch" readonly="1"/>

                            </group>
                            <group>
                                
                                <tree>
                                 <field name="case_type"/>
                                 <field name="total_sq_inch" readonly="1"/>
                                 <field name = "wastage_percent" />
                                 <field name="total_sq_inch_with_wastage"/>
                                 <field name="cft" readonly="1"/>
                                 <field name="rate"/>
                                 <field name="cost"/>
                                 </tree>
                            

                            </group>
                        </page>

                        <!-- ================= COST DETAILS ================= -->
                        <page string="Cost Details">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="section"/>
                                    <field name="description"/>

                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="qty"/>

                                    <field name="sq_inch" readonly="1"/>
                                    <field name="sq_ft" readonly="1"/>

                                    <field name="calculation_type"/>
                                    <field name="rate"/>
                                    <field name="cost" readonly="1"/>
                                </tree>
                            </field>
                             <!-- ================= TOTALS ================= -->
                            <group col="4" class="oe_subtotal_footer oe_right">

                                <field name="total_sq_inch" readonly="1"/>
                                <field name="wastage_percent"/>
                                <field name="total_sq_inch_with_wastage" readonly="1"/>
                                <field name="cft" readonly="1"/>

                                <field name="total_cost" readonly="1"
                                    widget="monetary"
                                    options="{'currency_field': 'company_currency_id'}"/>
                            </group>

                        
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_cost_breakup_tree" model="ir.ui.view">
        <field name="name">cost.breakup.tree</field>
        <field name="model">cost.breakup</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="case_type"/>
                <field name="product_weight"/>
            </tree>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_cost_breakup" model="ir.actions.act_window">
        <field name="name">Cost Break Up</field>
        <field name="res_model">cost.breakup</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_cost_breakup"
              name="Cost Break Up"
               parent="menu_engineering_root"
              action="action_cost_breakup"/>

</odoo>
