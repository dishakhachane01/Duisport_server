<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= REPORT TEMPLATE ================= -->

    <template id="report_qc_polybag">

        <t t-call="web.html_container">

            <meta charset="UTF-8"/>

            <style>

                @page {
                    size: A4;
                    margin: 5mm;
                }

                body {
                    font-size: 14px;
                    font-family: Arial, sans-serif;
                }

                .cell {
                    border: 1px solid #000;
                    padding: 6px;
                    vertical-align: top;
                }

                .center {
                    text-align: center;
                }

                .bold {
                    font-weight: bold;
                }

                .header-table {
                    width: 100%;
                    border: 1px solid #000;
                    border-collapse: collapse;
                }

                .header-cell {
                    border: 1px solid #000;
                    padding: 8px;
                }

            </style>


            <t t-foreach="docs" t-as="o">

                <div style="width:100%; height:287mm;">


                    <!-- ================= HEADER ================= -->

                    <table class="header-table">

                        <tr>

                            <td class="header-cell center" style="width:20%;">

                                <img t-if="env.company.logo"
                                     t-att-src="'data:image/png;base64,%s' % env.company.logo.decode()"
                                     style="max-height:70px;"/>

                            </td>


                            <td class="header-cell center" style="width:50%;">

                                <div class="bold">
                                    DUISPORT PACKING LOGISTICS INDIA PVT LTD.
                                </div>

                                <div class="bold" style="font-size:16px; margin-top:5px;">
                                    Incoming Inspection Report
                                </div>

                                <div class="bold" style="margin-top:5px;">
                                    Polybag
                                </div>

                            </td>


                            <td class="header-cell" style="width:30%;">

                                <div><b>DOC NO :</b> DPLIPL/P/QAD/10</div>
                                <div style="margin-top:10px;"><b>REV NO :</b> 01</div>
                                <div style="margin-top:10px;"><b>REV DATE :</b> 01/05/2025</div>

                            </td>

                        </tr>

                    </table>


                    <!-- ================= DETAILS ================= -->

                    <table style="width:100%; border-collapse:collapse; border-top:none;">


                        <tr>

                            <td class="cell" style="width:50%;">
                                <b>Date :</b>
                                <t t-esc="o.date.strftime('%d-%m-%Y') if o.date else ''"/>
                            </td>

                            <td class="cell" style="width:50%;">
                                <b>Supplier Code :</b>
                                <t t-esc="o.supplier_code"/>
                            </td>

                        </tr>


                        <tr>

                            <td class="cell">
                                <b>Material Type :</b>
                                <t t-esc="o.material_name"/>
                            </td>

                            <td class="cell">
                                <b>Customer Code :</b>
                                <t t-esc="o.customer_code"/>
                            </td>

                        </tr>


                        <tr>

                            <td class="cell">
                                <b>Invoice No/Date :</b>
                                <t t-esc="o.invoice_no"/> /
                                <t t-esc="o.invoice_date"/>
                            </td>

                            <td class="cell">
                                <b>Invoice Qty :</b>
                                <t t-esc="o.invoice_qty"/>
                            </td>

                        </tr>


                        <tr>

                            <td class="cell" colspan="2">

                                <b>For sampling :</b> IS-2500
                                <span style="margin-left:20px;"></span>
                                <b>Sample Qty :</b>
                                <t t-esc="o.sample_qty"/>

                            </td>

                        </tr>

                    </table>


                    <!-- ================= INSPECTION ================= -->

                    <table style="width:100%; border-collapse:collapse; margin-top:-1px;">


                        <tr class="center bold">

                            <td class="cell" style="width:8%;">S.No</td>
                            <td class="cell" style="width:35%;">Inspection Parameters</td>
                            <td class="cell" style="width:25%;">Std. Specification</td>
                            <td class="cell" style="width:32%;">Observations</td>

                        </tr>


                        <t t-foreach="o.inspection_lines" t-as="line">

                            <tr>

                                <td class="cell center">
                                    <t t-esc="line.sequence"/>
                                </td>

                                <td class="cell">
                                    <t t-esc="line.parameter"/>
                                </td>

                                <td class="cell center">
                                    <t t-esc="line.specification"/>
                                </td>

                                <td class="cell">
                                    <t t-esc="line.observation"/>
                                </td>

                            </tr>

                        </t>

                    </table>


                    <!-- ================= RESULT ================= -->

                    <table style="width:100%; border-collapse:collapse;">


                        <tr>

                            <td class="cell" style="width:33%;">
                                <b>Qty Accepted :</b>
                                <t t-esc="o.qty_accepted"/>
                            </td>

                            <td class="cell" style="width:33%;">
                                <b>Qty Hold :</b>
                                <t t-esc="o.qty_hold"/>
                            </td>

                            <td class="cell" style="width:34%;">
                                <b>Qty Rejected :</b>
                                <t t-esc="o.qty_rejected"/>
                            </td>

                        </tr>

                    </table>


                    <!-- ================= SIGN ================= -->

                    <table style="width:100%; border-collapse:collapse;">


                        <tr>

                            <td class="cell center" style="height:70px; width:50%;">

                                <b>INSPECTED BY</b><br/><br/>
                                <t t-esc="o.inspected_by.name if o.inspected_by else ''"/>

                            </td>


                            <td class="cell center" style="width:50%;">

                                <b>APPROVED BY</b><br/><br/>
                                <t t-esc="o.verified_by.name if o.verified_by else ''"/>

                            </td>

                        </tr>

                    </table>


                </div>

            </t>

        </t>

    </template>


    <!-- ================= REPORT ACTION ================= -->

    <record id="action_report_qc_polybag" model="ir.actions.report">

        <field name="name">Incoming Inspection - Polybag</field>
        <field name="model">dw.quality.check</field>
        <field name="report_type">qweb-pdf</field>

        <field name="report_name">
            your_module.report_qc_polybag
        </field>

        <field name="report_file">
            your_module.report_qc_polybag
        </field>

        <field name="print_report_name">
            'Polybag Inspection - %s' % (object.name or '')
        </field>

    </record>

</odoo>
