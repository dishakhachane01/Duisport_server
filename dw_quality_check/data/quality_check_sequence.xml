<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inward QC (Goods Receipt / Purchase) -->
    <record id="seq_qc_inward" model="ir.sequence">
        <field name="name">Quality Check - Inward</field>
        <field name="code">dw.quality.check.inward</field>
        <field name="prefix">QI/IN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Outward QC (Finished Goods / Manufacturing) -->
    <record id="seq_qc_outward" model="ir.sequence">
        <field name="name">Quality Check - Outward</field>
        <field name="code">dw.quality.check.outward</field>
        <field name="prefix">QI/OUT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>