<odoo>
    <record id="view_users_form_inherit_dreamwarez" model="ir.ui.view">
        <field name="name">res.users.form.inherit.dreamwarez</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Add custom label after notification_type -->
            <xpath expr="//field[@name='notification_type']" position="after">
                <label string="Dreamswobot Status"/>
            </xpath>

        </field>
    </record>
</odoo>