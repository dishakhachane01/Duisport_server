<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= GROUPS ================= -->

    <record id="group_rfq_user" model="res.groups">
        <field name="name">RFQ User</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_rfq_department" model="res.groups">
        <field name="name">RFQ Department</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('product_vendor_rfq.group_rfq_user'))]"/>
    </record>

    <record id="group_rfq_purchase_team" model="res.groups">
        <field name="name">RFQ Purchase Team</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('product_vendor_rfq.group_rfq_department'))]"/>
    </record>

    <!-- FINAL AUTHORITY GROUP -->
    <record id="group_rfq_purchase_admin" model="res.groups">
        <field name="name">RFQ Purchase Administrator</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('product_vendor_rfq.group_rfq_purchase_team'))]"/>
    </record>


    <!-- ================= RECORD RULES ================= -->

    <!-- RFQ USER: only own records -->
    <record id="rfq_request_user_rule" model="ir.rule">
        <field name="name">RFQ: User Own Records</field>
        <field name="model_id" ref="model_rfq_request"/>
        <field name="domain_force">
            [
                ('create_uid', '=', user.id),
                ('company_id', 'in', user.company_ids.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('product_vendor_rfq.group_rfq_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- DEPARTMENT: company records -->
    <record id="rfq_request_department_rule" model="ir.rule">
        <field name="name">RFQ: Department Access</field>
        <field name="model_id" ref="model_rfq_request"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('product_vendor_rfq.group_rfq_department'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- PURCHASE TEAM: company records (same as department but higher role) -->
    <record id="rfq_request_purchase_team_rule" model="ir.rule">
        <field name="name">RFQ: Purchase Team Access</field>
        <field name="model_id" ref="model_rfq_request"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('product_vendor_rfq.group_rfq_purchase_team'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- PURCHASE ADMIN: FULL ACCESS (FINAL OVERRIDE) -->
    <record id="rfq_request_purchase_admin_rule" model="ir.rule">
        <field name="name">RFQ: Purchase Admin Full Access</field>
        <field name="model_id" ref="model_rfq_request"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('product_vendor_rfq.group_rfq_purchase_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- GLOBAL COMPANY RESTRICTION (APPLIES TO ALL EXCEPT ADMIN OVERRIDE) -->
    <record id="rfq_request_multi_company_rule" model="ir.rule">
        <field name="name">RFQ: Company Restriction</field>
        <field name="model_id" ref="model_rfq_request"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

</odoo>