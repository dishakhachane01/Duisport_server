<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_custom_type" model="ir.ui.view">
        <field name="name">product.template.form.custom.type</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Hide original detailed_type -->
            <field name="detailed_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Show our custom field in its place -->
            <field name="detailed_type" position="after">
                <field name="custom_product_type" required="1"/>
            </field>

        </field>
    </record>
</odoo>