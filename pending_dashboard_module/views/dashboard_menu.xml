
<odoo>
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">advanced_dashboard</field>
    </record>

    <!-- ROOT MENU (TOP BAR) -->
    <menuitem id="menu_dashboard_root"
              name="Dashboard"
              sequence="1"
              web_icon="base,static/description/icon.png"
              groups="product_vendor_rfq.group_management_approval,product_vendor_rfq.group_accounts_approval_m"/>

    <!-- CHILD MENU -->
    <menuitem id="menu_dashboard"
              name="Overview"
              parent="menu_dashboard_root"
              action="action_dashboard"
              sequence="1"/>
</odoo>
